# Copie para .env na raiz e/ou em apps/engine e apps/web.
# Nunca commite o .env. Nunca use NEXT_PUBLIC_ para segredo.

# Postgres local: docker compose up -d postgres
# Deixe vazio para subir o engine só em memória (desenvolvimento).
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading

BINANCE_API_KEY=
BINANCE_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROMPT_VERSION=market_interpreter_v1
# Deixe vazio para gravar tokens sem inventar dólar.
OPENAI_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
# Chamadas pagas também exigem call_model=true na estratégia (dashboard).
OPENAI_TIMEOUT_S=12

# auto = mock enquanto key e URL estiverem vazios; com os dois, chama o Jev real.
# JEV_BASE_URL é o POST inteiro. TypeSafe: https://api.typesafe.ai/v1/systemone
# O corpo é model + state + questions (noul). A resposta answers.*.noul vira o veto.
# Falha do Jev continua NO_TRADE. Isto não arma ordem real.
JEV_PROVIDER=auto
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
JEV_PROMPT_VERSION=jev_market_v1
JEV_FAILURE_POLICY=NO_TRADE
JEV_TIMEOUT_S=3

ENGINE_API_SECRET=
ENVIRONMENT=development

# Kill switch de boot. O dashboard também consegue parar o processo em execução.
TRADING_ENGINE_ENABLED=true

# As duas precisam ser true, e a estratégia precisa estar em mode=live.
TRADING_LIVE_ENABLED=false
ALLOW_REAL_ORDERS=false

MARKET_TYPE=futures
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SNAPSHOT_TRIGGER=1m_close

DEFAULT_RISK_PER_TRADE=0.005
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_DAILY_DRAWDOWN=0.03
# exposure ≈ risk_per_trade / stop_distance_pct. 0.5% de risco com stop de 2% usa ~25% do capital.
MAX_TOTAL_EXPOSURE=1
MAX_SYMBOL_EXPOSURE=0.4
MAX_OPEN_POSITIONS=3
MIN_NET_RR=3.0
INITIAL_PAPER_EQUITY=10000

# Usadas só se a Binance não devolver a taxa da conta.
# Valores conservadores de partida, não uma tabela oficial cravada no código.
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005

SLIPPAGE_MODEL=orderbook_based
FIXED_SLIPPAGE_BPS=1.0
STALE_AFTER_MS=5000
MAX_SIGNAL_AGE_MS=8000
PAPER_SEED=1

EVOLUTION_ENGINE_ENABLED=true
AUTO_RESEARCH=true
AUTO_BUILD=false
AUTO_SHADOW_PROMOTION=false
AUTO_PAPER_PROMOTION=false
MAX_DAILY_EXPERIMENTS=3
MIN_EXPERIMENT_SAMPLE_SIZE=100
CODING_AGENT_PROVIDER=mock
HUMAN_APPROVAL_REQUIRED=true
OPENAI_RESEARCH_MODEL=
OPENAI_RESEARCH_PROMPT_VERSION=evolution_researcher_v1

LOG_LEVEL=INFO
LOG_JSON=false
HOST=0.0.0.0
PORT=8000
WEB_ORIGIN=http://localhost:3000

# --- somente servidor Next.js (apps/web/.env.local). Sem prefixo NEXT_PUBLIC_. ---
# ENGINE_API_URL=http://127.0.0.1:8000
# ENGINE_API_SECRET=
